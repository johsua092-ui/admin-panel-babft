# === Firebase (harus diisi — jangan hardcode di kode) ===
# Salin dari: Firebase Console -> Project settings -> General -> Your apps -> Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# === Whitelist anggota (fallback env — opsional) ===
# Daftar email anggota, koma-separated. Disarankan pakai Firestore untuk produksi.
# Contoh: anggota1@gmail.com,anggota2@gmail.com
NEXT_PUBLIC_ADMIN_EMAILS=

# === Nama koleksi (opsional, kalau mau ganti dari default) ===
# NEXT_PUBLIC_ADMINS_COLLECTION=admins
# NEXT_PUBLIC_USERS_COLLECTION=users

# === Service Account (untuk baca koleksi users via Admin SDK) ===
# Generate di Firebase Console -> Project settings -> Service accounts.
# Isi dengan JSON service account (satu baris), ATAU field per field:
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY=
# FIREBASE_ADMIN_PROJECT_ID=

# === Convex (jalur data) ===
CONVEX_URL=
DATA_BACKEND=FIREBASE
MIRROR_WRITES=false
# CONVEX_DEPLOY_KEY=dev:<slug>|<key>
