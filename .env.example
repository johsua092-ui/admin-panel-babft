# ===========================================================================
# ENVIRONMENT VARIABLES — ADMIN PANEL BABFT
# Set di Vercel: Project "admin-panel-babft" -> Settings -> Environment Variables
# JANGAN commit nilai rahasia ke repo. File .env di-ignore git.
#
# Setup date: 2026-08-19 (post-Turso migration)
# Type: ALL env vars pakai type "plain" (NO encrypted, per user policy)
# ===========================================================================

# ---------------------------------------------------------------------------
# 1) DATA BACKEND — pilih sumber data admin panel
#    TURSO    -> libSQL (DEFAULT, sekarang dipake)
#    FIREBASE -> Firestore (legacy, gak dipake lagi, fallback only)
#    CONVEX   -> Convex (legacy, gak dipake lagi)
# ---------------------------------------------------------------------------
DATA_BACKEND=TURSO
MIRROR_WRITES=false

# ---------------------------------------------------------------------------
# 2) TURSO (libSQL) — primary data backend
#    Dashboard: https://app.turso.tech/johsua092-ui/databases/backend
# ---------------------------------------------------------------------------
TURSO_DATABASE_URL=libsql://backend-johsua092-ui.aws-ap-northeast-1.turso.io
TURSO_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# 3) INGEST — pintu tulis dari frontend Babftss ke admin panel
#    Origin allowlist (CORS). Wajib diset, TIDAK ada hardcoded fallback di kode.
# ---------------------------------------------------------------------------
INGEST_ORIGINS=https://babftss.vercel.app,https://babftlearning.dpdns.org,https://babft-project.vercel.app,https://babft-learning-project.zone.id,https://babft-learning.ryzn.pro,https://babft-learning.net,https://babft-learning.com,https://www.babft-learning.net,https://www.babft-learning.com,https://babft.learning.project.thedev.me

# ---------------------------------------------------------------------------
# 4) FIREBASE CLIENT SDK (NEXT_PUBLIC_*) — project backend-fb691
#    Buat login Google admin panel. Public config (bukan rahasia).
#    Salin dari: Firebase Console -> backend-fb691 -> Project settings -> Web app
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=backend-fb691.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=backend-fb691
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=backend-fb691.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# 5) ADMIN WHITELIST — email yang boleh login ke panel
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ADMIN_EMAILS=johsua092@gmail.com,aremakonveksi@gmail.com

# ---------------------------------------------------------------------------
# 6) FIREBASE ADMIN SDK (server-side) — project backend-fb691
#    Buat verifikasi ID token admin yang login. WAJIB diset.
#    Generate: Firebase Console -> backend-fb691 -> Project settings -> Service accounts
# ---------------------------------------------------------------------------
FIREBASE_AUTH_ADMIN_PROJECT_ID=backend-fb691
FIREBASE_AUTH_ADMIN_CLIENT_EMAIL=
FIREBASE_AUTH_ADMIN_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# 7) LOCKDOWN (opsional) — kode rahasia untuk lock/unlock panel
#    Rekomendasi: isi dengan HASH SHA-256 (64 hex) dari kode asli
# ---------------------------------------------------------------------------
LOCKDOWN_CODE=

# ---------------------------------------------------------------------------
# 8) VERCEL — untuk /api/traffic (Vercel Web Analytics Babftss)
# ---------------------------------------------------------------------------
VERCEL_TOKEN=
VERCEL_PROJECT_ID=prj_Hi7p0TTJeGRgTfPNBTassdOmG6MX
VERCEL_TEAM_ID=team_DKKUOM4YzSC42BPDP1wNSmLh

# ---------------------------------------------------------------------------
# 9) COLLECTION NAMING (opsional, default: users / analytics / admins)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_USERS_COLLECTION=users
# NEXT_PUBLIC_ANALYTICS_COLLECTION=analytics
# NEXT_PUBLIC_ADMINS_COLLECTION=admins

# ===========================================================================
# NOTE: env vars FIREBASE_ADMIN_* (project punya-si-jawa) dan CONVEX_*
# sudah dihapus dari Vercel — tidak dipake lagi setelah migrasi Turso.
# Code masih punya firestoreDataSource.ts + convexDataSource.ts sebagai
# fallback, tapi gak akan dipanggil kalau DATA_BACKEND=TURSO.
# ===========================================================================
