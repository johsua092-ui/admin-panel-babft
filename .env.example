# ===========================================================================
# ENVIRONMENT VARIABLES — ADMIN PANEL BABFT (Penjual Sayur)
# Set di Vercel: Project "admin-panel-babft" -> Settings -> Environment Variables
# JANGAN commit nilai rahasia ke repo. File .env di-ignore git.
# ===========================================================================

# ---------------------------------------------------------------------------
# 1) FIREBASE AUTH (project backend-fb691) — untuk login Google admin panel
#    Salin dari: Firebase Console -> backend-fb691 -> Project settings -> Web app
#    NOTE: ini WAJIB lengkap, kalau kosong build gagal.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=backend-fb691.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=backend-fb691
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# 2) SERVICE ACCOUNT AUTH (backend-fb691) — buat verifikasi ID token di server
#    (dipakai authGuard.ts / requireAdmin).
#    Generate: Firebase Console -> backend-fb691 -> Project settings -> Service accounts -> Generate new private key
#    WAJIB diset, kalau tidak semua API data bakal 401.
# ---------------------------------------------------------------------------
FIREBASE_AUTH_ADMIN_PROJECT_ID=backend-fb691
FIREBASE_AUTH_ADMIN_CLIENT_EMAIL=
FIREBASE_AUTH_ADMIN_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# 3) DATABASE USER (project punya-si-jawa) — koleksi `users` di web teman mu
#    Config publik (bukan rahasia). Salin dari Firebase Console -> punya-si-jawa -> Web app
# ---------------------------------------------------------------------------
NEXT_PUBLIC_USERDB_API_KEY=
NEXT_PUBLIC_USERDB_AUTH_DOMAIN=
NEXT_PUBLIC_USERDB_PROJECT_ID=punya-si-jawa
NEXT_PUBLIC_USERDB_STORAGE_BUCKET=
NEXT_PUBLIC_USERDB_MESSAGING_SENDER_ID=
NEXT_PUBLIC_USERDB_APP_ID=

# ---------------------------------------------------------------------------
# 4) SERVICE ACCOUNT DATA (punya-si-jawa) — baca/tulis koleksi users via Admin SDK
#    Generate: Firebase Console -> punya-si-jawa -> Project settings -> Service accounts
# ---------------------------------------------------------------------------
FIREBASE_ADMIN_PROJECT_ID=punya-si-jawa
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# 5) WHITELIST ADMIN (owner) — email yang boleh akses panel + unlock lockdown
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ADMIN_EMAILS=johsua092@gmail.com,aremakonveksi@gmail.com

# ---------------------------------------------------------------------------
# 6) DATA BACKEND
#    DATA_BACKEND=CONVEX  -> pakai Convex sebagai sumber data panel
#    DATA_BACKEND=FIREBASE -> pakai Firestore langsung (punya-si-jawa)
# ---------------------------------------------------------------------------
DATA_BACKEND=CONVEX
# DATA_BACKEND=FIREBASE

# Convex deployment URL (dari `npx convex deploy` output, atau Convex dashboard)
# Format contoh: https://<slug>.convex.site   ATAU   https://<slug>.convex.cloud
CONVEX_URL=

# Mirror write ke backend sekunder (opsional)
MIRROR_WRITES=false

# ---------------------------------------------------------------------------
# 7) LOCKDOWN — kode rahasia untuk kunci/buka panel.
#    REKOMENDASI: isi dengan HASH SHA-256 (64 hex) dari kode rahasia kamu,
#    BUKAN kode aslinya. Contoh: echo -n "koderahasiamu" | shasum -a 256
#    (maskud: simpan hash-nya, kode asli cuma di kepala kamu). Jangan share.
# ---------------------------------------------------------------------------
LOCKDOWN_CODE=

# ---------------------------------------------------------------------------
# 8) NAMA KOLEKSI (opsional, override default)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_ADMINS_COLLECTION=admins
# NEXT_PUBLIC_USERS_COLLECTION=users
# NEXT_PUBLIC_ANALYTICS_COLLECTION=analytics

# ---------------------------------------------------------------------------
# 9) VERCEL (untuk /api/traffic — membaca Web Analytics)
# ---------------------------------------------------------------------------
VERCEL_TOKEN=
VERCEL_PROJECT_ID=prj_hsCCh7wbVBdxRVRQKH0AuzsAW8HA
VERCEL_TEAM_ID=
